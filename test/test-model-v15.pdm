<c:Views>
<o:View Id="o1398">
<a:ObjectID>48694437-D119-44A6-BFFA-F493E7108D69</a:ObjectID>
<a:Name>vopenday</a:Name>
<a:Code>vopenday</a:Code>
<a:CreationDate>1516331250</a:CreationDate>
<a:Creator>qiandl21906</a:Creator>
<a:ModificationDate>1533632474</a:ModificationDate>
<a:Modifier>qiandl21906</a:Modifier>
<a:BeginScript>select /*+ index(a IOPENDAY_TACODE) index(a IOPENDAY_FUNDCODE) index(a IOPENDAY_TACODE_TA) index(b IOPENDAYREUSE_TACODE) index(b IOPENDAYREUSE_FUNDCODE)*/
a.d_date,a.l_workflag,a.c_memo,b.vc_tacode,b.vc_fundcode
from topenday a,topendayreuse b
where a.vc_tacode = b.vc_oritacode
   and nvl(a.vc_fundcode,&#39;-&#39;) = nvl(b.vc_orifundcode,&#39;-&#39;)
union all
select /*+ index(a IOPENDAY_TACODE) index(a IOPENDAY_FUNDCODE) index(a IOPENDAY_TACODE_TA)*/
a.d_date,a.l_workflag,a.c_memo,a.vc_tacode,a.vc_fundcode
from topenday a;</a:BeginScript>
<a:View.SQLQuery>select</a:View.SQLQuery>
<a:TaggedSQLQuery>select</a:TaggedSQLQuery>
</o:View>
</c:Views>
