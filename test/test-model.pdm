<?xml version="1.0" encoding="UTF-8"?>
<o:Model xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:a="urn:schemas-microsoft-com:office:access" xmlns:c="urn:schemas-microsoft-com:office:custom" Id="o1">
  <a:Name>电商业务系统</a:Name>
  <a:Code>SHOP</a:Code>
  <a:Comment>电商业务系统物理数据模型（测试样例）</a:Comment>
  <a:Author>测试</a:Author>
  <c:DBMS><o:Shortcut Id="dbms1"><a:Name>MySQL 5.7</a:Name></o:Shortcut></c:DBMS>
  <c:Children>
    <o:Package Id="pkg1">
      <a:Name>用户模块</a:Name>
      <a:Code>USER_MOD</a:Code>
      <c:Children>
    <o:Table Id="t1">
      <a:Name>用户表</a:Name>
      <a:Code>SYS_USER</a:Code>
      <a:Comment>系统用户信息表</a:Comment>
      <c:Columns>
      <o:Column Id="c1">
        <a:Name>用户ID</a:Name>
        <a:Code>USER_ID</a:Code>
        <a:Comment>主键，自增</a:Comment>
        <a:DataType>BIGINT</a:DataType>
        <a:Length>19</a:Length>
        <a:Column.Mandatory>1</a:Column.Mandatory>
        <a:Identity>1</a:Identity>
        <a:Sequence>1</a:Sequence>
      </o:Column>
      <o:Column Id="c2">
        <a:Name>用户名</a:Name>
        <a:Code>USERNAME</a:Code>
        <a:Comment>登录账号，唯一</a:Comment>
        <a:DataType>VARCHAR</a:DataType>
        <a:Length>64</a:Length>
        <a:Column.Mandatory>1</a:Column.Mandatory>
        <a:Sequence>2</a:Sequence>
      </o:Column>
      <o:Column Id="c3">
        <a:Name>密码</a:Name>
        <a:Code>PASSWORD</a:Code>
        <a:Comment>加密后的密码</a:Comment>
        <a:DataType>VARCHAR</a:DataType>
        <a:Length>128</a:Length>
        <a:Column.Mandatory>1</a:Column.Mandatory>
        <a:Sequence>3</a:Sequence>
      </o:Column>
      <o:Column Id="c4">
        <a:Name>真实姓名</a:Name>
        <a:Code>REAL_NAME</a:Code>
        <a:DataType>VARCHAR</a:DataType>
        <a:Length>64</a:Length>
        <a:Sequence>4</a:Sequence>
      </o:Column>
      <o:Column Id="c5">
        <a:Name>手机号</a:Name>
        <a:Code>PHONE</a:Code>
        <a:DataType>VARCHAR</a:DataType>
        <a:Length>20</a:Length>
        <a:Sequence>5</a:Sequence>
      </o:Column>
      <o:Column Id="c6">
        <a:Name>邮箱</a:Name>
        <a:Code>EMAIL</a:Code>
        <a:DataType>VARCHAR</a:DataType>
        <a:Length>128</a:Length>
        <a:Sequence>6</a:Sequence>
      </o:Column>
      <o:Column Id="c7">
        <a:Name>状态</a:Name>
        <a:Code>STATUS</a:Code>
        <a:Comment>0-禁用 1-启用</a:Comment>
        <a:DataType>SMALLINT</a:DataType>
        <a:Length>2</a:Length>
        <a:Column.Mandatory>1</a:Column.Mandatory>
        <a:DefaultValue>'1'</a:DefaultValue>
        <a:Sequence>7</a:Sequence>
      </o:Column>
      <o:Column Id="c8">
        <a:Name>创建时间</a:Name>
        <a:Code>CREATE_TIME</a:Code>
        <a:Comment>注册时间</a:Comment>
        <a:DataType>DATETIME</a:DataType>
        <a:Column.Mandatory>1</a:Column.Mandatory>
        <a:Sequence>8</a:Sequence>
      </o:Column>
      </c:Columns>
      <c:Keys>
        <o:Key Id="k1">
          <a:Name>Keyk1</a:Name>
          <c:Key.Columns>
            <o:Column Ref="c1"/>
          </c:Key.Columns>
        </o:Key>
      </c:Keys>
      <c:PrimaryKey>
        <o:Key Ref="k1"/>
      </c:PrimaryKey>
      <c:Indexes>
        <o:Index Id="i1">
          <a:Name>IDX_USER_NAME</a:Name>
          <a:Code>UK_USER_USERNAME</a:Code>
          <a:Unique>1</a:Unique>
          <c:IndexColumns>
            <o:IndexColumn Id="ic_i1_c2">
              <a:SortOrder>ASC</a:SortOrder>
              <c:Column><o:Column Ref="c2"/></c:Column>
            </o:IndexColumn>
          </c:IndexColumns>
        </o:Index>
      </c:Indexes>
      <c:Triggers>
        <o:Trigger Id="tg1">
          <a:Name>触发-用户创建</a:Name>
          <a:Code>TRG_USER_CREATE</a:Code>
          <a:TriggerTiming>AFTER</a:TriggerTiming>
          <a:TriggerEvent>INSERT</a:TriggerEvent>
          <a:SQLText>INSERT INTO SYS_LOG(EVENT) VALUES('user created')</a:SQLText>
        </o:Trigger>
      </c:Triggers>
    </o:Table>
    <o:Table Id="t2">
      <a:Name>角色表</a:Name>
      <a:Code>SYS_ROLE</a:Code>
      <a:Comment>系统角色定义</a:Comment>
      <c:Columns>
      <o:Column Id="c10">
        <a:Name>角色ID</a:Name>
        <a:Code>ROLE_ID</a:Code>
        <a:DataType>BIGINT</a:DataType>
        <a:Length>19</a:Length>
        <a:Column.Mandatory>1</a:Column.Mandatory>
        <a:Identity>1</a:Identity>
        <a:Sequence>1</a:Sequence>
      </o:Column>
      <o:Column Id="c11">
        <a:Name>角色编码</a:Name>
        <a:Code>ROLE_CODE</a:Code>
        <a:DataType>VARCHAR</a:DataType>
        <a:Length>64</a:Length>
        <a:Column.Mandatory>1</a:Column.Mandatory>
        <a:Sequence>2</a:Sequence>
      </o:Column>
      <o:Column Id="c12">
        <a:Name>角色名称</a:Name>
        <a:Code>ROLE_NAME</a:Code>
        <a:DataType>VARCHAR</a:DataType>
        <a:Length>128</a:Length>
        <a:Column.Mandatory>1</a:Column.Mandatory>
        <a:Sequence>3</a:Sequence>
      </o:Column>
      </c:Columns>
      <c:Keys>
        <o:Key Id="k2">
          <a:Name>Keyk2</a:Name>
          <c:Key.Columns>
            <o:Column Ref="c10"/>
          </c:Key.Columns>
        </o:Key>
      </c:Keys>
      <c:PrimaryKey>
        <o:Key Ref="k2"/>
      </c:PrimaryKey>
    </o:Table>
    <o:Table Id="t3">
      <a:Name>用户角色表</a:Name>
      <a:Code>SYS_USER_ROLE</a:Code>
      <a:Comment>用户与角色多对多关系</a:Comment>
      <c:Columns>
      <o:Column Id="c20">
        <a:Name>主键ID</a:Name>
        <a:Code>ID</a:Code>
        <a:DataType>BIGINT</a:DataType>
        <a:Length>19</a:Length>
        <a:Column.Mandatory>1</a:Column.Mandatory>
        <a:Identity>1</a:Identity>
        <a:Sequence>1</a:Sequence>
      </o:Column>
      <o:Column Id="c21">
        <a:Name>用户ID</a:Name>
        <a:Code>USER_ID</a:Code>
        <a:Comment>引用用户表</a:Comment>
        <a:DataType>BIGINT</a:DataType>
        <a:Length>19</a:Length>
        <a:Column.Mandatory>1</a:Column.Mandatory>
        <a:Sequence>2</a:Sequence>
      </o:Column>
      <o:Column Id="c22">
        <a:Name>角色ID</a:Name>
        <a:Code>ROLE_ID</a:Code>
        <a:Comment>引用角色表</a:Comment>
        <a:DataType>BIGINT</a:DataType>
        <a:Length>19</a:Length>
        <a:Column.Mandatory>1</a:Column.Mandatory>
        <a:Sequence>3</a:Sequence>
      </o:Column>
      </c:Columns>
      <c:Keys>
        <o:Key Id="k3">
          <a:Name>Keyk3</a:Name>
          <c:Key.Columns>
            <o:Column Ref="c20"/>
          </c:Key.Columns>
        </o:Key>
      </c:Keys>
      <c:PrimaryKey>
        <o:Key Ref="k3"/>
      </c:PrimaryKey>
    </o:Table>
        <o:Reference Id="r1">
    <a:Name>FK_USER_ROLE_USER</a:Name>
    <a:Code>FK_USER_ROLE_USER</a:Code>
