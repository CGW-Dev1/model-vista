    <o:Procedure Id="sp1">
      <a:Name>计算订单金额</a:Name>
      <a:Code>SP_CALC_ORDER_AMOUNT</a:Code>
      <a:Comment>根据明细汇总订单金额</a:Comment>
      <a:SQLText>CREATE PROCEDURE SP_CALC_ORDER_AMOUNT(p_order_id BIGINT) BEGIN SELECT SUM(QTY*PRICE) INTO @amt FROM ORD_ORDER_ITEM WHERE ORDER_ID = p_order_id; UPDATE ORD_ORDER SET AMOUNT = @amt WHERE ORDER_ID = p_order_id; END</a:SQLText>
    </o:Procedure>
