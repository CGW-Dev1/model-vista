    </o:Package>
    <o:Package Id="pkg2">
      <a:Name>订单模块</a:Name>
      <a:Code>ORDER_MOD</a:Code>
      <c:Children>
    <o:Table Id="t4">
      <a:Name>订单表</a:Name>
      <a:Code>ORD_ORDER</a:Code>
      <a:Comment>销售订单主表</a:Comment>
      <c:Columns>
      <o:Column Id="c30">
        <a:Name>订单ID</a:Name>
        <a:Code>ORDER_ID</a:Code>
        <a:Comment>主键</a:Comment>
        <a:DataType>BIGINT</a:DataType>
        <a:Length>19</a:Length>
        <a:Column.Mandatory>1</a:Column.Mandatory>
        <a:Identity>1</a:Identity>
        <a:Sequence>1</a:Sequence>
      </o:Column>
      <o:Column Id="c31">
        <a:Name>订单号</a:Name>
        <a:Code>ORDER_NO</a:Code>
        <a:Comment>业务订单号，规则：ORD+日期+序列</a:Comment>
        <a:DataType>VARCHAR</a:DataType>
        <a:Length>32</a:Length>
        <a:Column.Mandatory>1</a:Column.Mandatory>
        <a:Sequence>2</a:Sequence>
      </o:Column>
      <o:Column Id="c32">
        <a:Name>用户ID</a:Name>
        <a:Code>USER_ID</a:Code>
        <a:Comment>下单用户</a:Comment>
        <a:DataType>BIGINT</a:DataType>
        <a:Length>19</a:Length>
        <a:Column.Mandatory>1</a:Column.Mandatory>
        <a:Sequence>3</a:Sequence>
      </o:Column>
      <o:Column Id="c33">
        <a:Name>订单金额</a:Name>
        <a:Code>AMOUNT</a:Code>
        <a:Comment>订单总金额</a:Comment>
        <a:DataType>DECIMAL</a:DataType>
        <a:Length>12</a:Length>
        <a:Precision>2</a:Precision>
        <a:Column.Mandatory>1</a:Column.Mandatory>
        <a:Sequence>4</a:Sequence>
      </o:Column>
      <o:Column Id="c34">
        <a:Name>订单状态</a:Name>
        <a:Code>STATUS</a:Code>
        <a:Comment>0-待支付 1-已支付 2-已发货 3-已完成 4-已取消</a:Comment>
        <a:DataType>SMALLINT</a:DataType>
        <a:Length>2</a:Length>
        <a:Column.Mandatory>1</a:Column.Mandatory>
        <a:Sequence>5</a:Sequence>
      </o:Column>
      <o:Column Id="c35">
        <a:Name>下单时间</a:Name>
        <a:Code>CREATE_TIME</a:Code>
        <a:DataType>DATETIME</a:DataType>
        <a:Column.Mandatory>1</a:Column.Mandatory>
        <a:Sequence>6</a:Sequence>
      </o:Column>
      </c:Columns>
      <c:Keys>
        <o:Key Id="k4">
          <a:Name>Keyk4</a:Name>
          <c:Key.Columns>
            <o:Column Ref="c30"/>
          </c:Key.Columns>
        </o:Key>
      </c:Keys>
      <c:PrimaryKey>
        <o:Key Ref="k4"/>
      </c:PrimaryKey>
      <c:Indexes>
        <o:Index Id="i2">
          <a:Name>IDX_ORDER_USER</a:Name>
          <a:Code>IDX_ORD_ORDER_USER</a:Code>
          <c:IndexColumns>
            <o:IndexColumn Id="ic_i2_c32">
              <a:SortOrder>ASC</a:SortOrder>
              <c:Column><o:Column Ref="c32"/></c:Column>
            </o:IndexColumn>
          </c:IndexColumns>
        </o:Index>
      </c:Indexes>
      <c:Triggers>
        <o:Trigger Id="tg2">
          <a:Name>触发-订单创建</a:Name>
          <a:Code>TRG_ORDER_CREATE</a:Code>
          <a:TriggerTiming>AFTER</a:TriggerTiming>
          <a:TriggerEvent>INSERT</a:TriggerEvent>
          <a:SQLText>UPDATE SYS_STAT SET ORDER_COUNT = ORDER_COUNT + 1</a:SQLText>
        </o:Trigger>
      </c:Triggers>
    </o:Table>
    <o:Table Id="t5">
      <a:Name>订单明细表</a:Name>
      <a:Code>ORD_ORDER_ITEM</a:Code>
      <a:Comment>订单商品明细</a:Comment>
      <c:Columns>
      <o:Column Id="c40">
        <a:Name>明细ID</a:Name>
        <a:Code>ITEM_ID</a:Code>
        <a:DataType>BIGINT</a:DataType>
        <a:Length>19</a:Length>
        <a:Column.Mandatory>1</a:Column.Mandatory>
        <a:Identity>1</a:Identity>
        <a:Sequence>1</a:Sequence>
      </o:Column>
      <o:Column Id="c41">
        <a:Name>订单ID</a:Name>
        <a:Code>ORDER_ID</a:Code>
        <a:Comment>所属订单</a:Comment>
        <a:DataType>BIGINT</a:DataType>
        <a:Length>19</a:Length>
        <a:Column.Mandatory>1</a:Column.Mandatory>
        <a:Sequence>2</a:Sequence>
      </o:Column>
      <o:Column Id="c42">
        <a:Name>商品ID</a:Name>
        <a:Code>PRODUCT_ID</a:Code>
        <a:Comment>购买的商品</a:Comment>
        <a:DataType>BIGINT</a:DataType>
        <a:Length>19</a:Length>
        <a:Column.Mandatory>1</a:Column.Mandatory>
        <a:Sequence>3</a:Sequence>
      </o:Column>
      <o:Column Id="c43">
        <a:Name>数量</a:Name>
        <a:Code>QTY</a:Code>
        <a:DataType>INT</a:DataType>
        <a:Length>10</a:Length>
        <a:Column.Mandatory>1</a:Column.Mandatory>
        <a:Sequence>4</a:Sequence>
      </o:Column>
      <o:Column Id="c44">
        <a:Name>单价</a:Name>
        <a:Code>PRICE</a:Code>
        <a:Comment>成交单价</a:Comment>
        <a:DataType>DECIMAL</a:DataType>
        <a:Length>12</a:Length>
        <a:Precision>2</a:Precision>
        <a:Column.Mandatory>1</a:Column.Mandatory>
        <a:Sequence>5</a:Sequence>
      </o:Column>
      </c:Columns>
      <c:Keys>
        <o:Key Id="k5">
          <a:Name>Keyk5</a:Name>
          <c:Key.Columns>
            <o:Column Ref="c40"/>
          </c:Key.Columns>
        </o:Key>
      </c:Keys>
      <c:PrimaryKey>
        <o:Key Ref="k5"/>
      </c:PrimaryKey>
    </o:Table>
    <o:View Id="v1">
      <a:Name>订单明细视图</a:Name>
      <a:Code>V_ORDER_DETAIL</a:Code>
      <a:Comment>订单与商品汇总查询视图</a:Comment>
      <c:Columns>
        <o:ViewColumn Id="vc1"><a:Name>订单号</a:Name><a:Code>ORDER_NO</a:Code><a:Sequence>1</a:Sequence></o:ViewColumn>
        <o:ViewColumn Id="vc2"><a:Name>用户名</a:Name><a:Code>USERNAME</a:Code><a:Sequence>2</a:Sequence></o:ViewColumn>
        <o:ViewColumn Id="vc3"><a:Name>商品名称</a:Name><a:Code>PRODUCT_NAME</a:Code><a:Sequence>3</a:Sequence></o:ViewColumn>
      </c:Columns>
      <a:SQLText>SELECT o.ORDER_NO, u.USERNAME, i.QTY, i.PRICE, p.PRODUCT_NAME FROM ORD_ORDER o JOIN SYS_USER u ON o.USER_ID = u.USER_ID JOIN ORD_ORDER_ITEM i ON i.ORDER_ID = o.ORDER_ID JOIN PRD_PRODUCT p ON p.PRODUCT_ID = i.PRODUCT_ID</a:SQLText>
    </o:View>
        <o:Reference Id="r3">
    <a:Name>FK_ORDER_USER</a:Name>
    <a:Code>FK_ORDER_USER</a:Code>
    <c:ParentTable><o:Table Ref="t1"/></c:ParentTable>
    <c:ChildTable><o:Table Ref="t4"/></c:ChildTable>
    <c:Joins>
      <o:ReferenceJoin Id="r3j">
        <c:Object1Table><o:Column Ref="c1"/></c:Object1Table>
        <c:Object2Table><o:Column Ref="c32"/></c:Object2Table>
      </o:ReferenceJoin>
    </c:Joins>
  </o:Reference>
        <o:Reference Id="r4">
    <a:Name>FK_ORDER_ITEM_ORDER</a:Name>
    <a:Code>FK_ORDER_ITEM_ORDER</a:Code>
    <c:ParentTable><o:Table Ref="t4"/></c:ParentTable>
    <c:ChildTable><o:Table Ref="t5"/></c:ChildTable>
