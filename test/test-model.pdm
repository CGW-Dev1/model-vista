    <o:Package Id="pkg3">
      <a:Name>商品模块</a:Name>
      <a:Code>PRD_MOD</a:Code>
      <c:Children>
    <o:Table Id="t6">
      <a:Name>商品表</a:Name>
      <a:Code>PRD_PRODUCT</a:Code>
      <a:Comment>在售商品信息</a:Comment>
      <c:Columns>
      <o:Column Id="c50">
        <a:Name>商品ID</a:Name>
        <a:Code>PRODUCT_ID</a:Code>
        <a:DataType>BIGINT</a:DataType>
        <a:Length>19</a:Length>
        <a:Column.Mandatory>1</a:Column.Mandatory>
        <a:Identity>1</a:Identity>
        <a:Sequence>1</a:Sequence>
      </o:Column>
      <o:Column Id="c51">
        <a:Name>商品编码</a:Name>
