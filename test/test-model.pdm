    <o:Table Id="t7">
      <a:Name>商品分类表</a:Name>
      <a:Code>PRD_CATEGORY</a:Code>
      <a:Comment>商品分类树</a:Comment>
      <c:Columns>
      <o:Column Id="c60">
        <a:Name>分类ID</a:Name>
        <a:Code>CATEGORY_ID</a:Code>
        <a:DataType>BIGINT</a:DataType>
        <a:Length>19</a:Length>
        <a:Column.Mandatory>1</a:Column.Mandatory>
        <a:Identity>1</a:Identity>
        <a:Sequence>1</a:Sequence>
      </o:Column>
      <o:Column Id="c61">
        <a:Name>分类名称</a:Name>
        <a:Code>CATEGORY_NAME</a:Code>
        <a:DataType>VARCHAR</a:DataType>
        <a:Length>128</a:Length>
